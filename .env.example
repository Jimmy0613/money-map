# Copy to .env locally. Never commit or print actual secrets.
APP_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=5432
POSTGRES_DB=money_map
POSTGRES_USER=money_map
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/money_map
SPRING_DATASOURCE_USERNAME=money_map
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_SAME_DB_SECRET
JWT_SECRET=REPLACE_WITH_BASE64_32_RANDOM_BYTES
CURSOR_SECRET=REPLACE_WITH_DIFFERENT_BASE64_32_RANDOM_BYTES
AUTH_COOKIE_SECURE=false
SPRING_PROFILES_ACTIVE=local
BACKEND_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Keep true for any restored candidate until authoritative ledger/WAL verification.
APP_RECOVERY_REQUIRED=false

# Production is blocked without a fresh signed authority decision, even when the flag is false.
# Public key: base64 X.509 DER Ed25519 public key; never the private signing key.
RECOVERY_AUTHORITY_URL=
RECOVERY_AUTHORITY_PUBLIC_KEY=
RECOVERY_ENVIRONMENT=
RECOVERY_DEPLOYMENT=

# Shared demo protection. Keep public signup closed; configure an isolated account separately.
APP_DEMO_EMAILS=
APP_DEMO_MAX_CREATED_TRANSACTIONS=200
APP_DEMO_MAX_CATEGORIES=40
APP_DEMO_MAX_SESSIONS=10
APP_DEMO_MAX_SESSION_TOKENS=60
APP_REQUESTS_PER_MINUTE=300
APP_MUTATIONS_PER_MINUTE=60
